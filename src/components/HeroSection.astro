---

---

<section class="hero">
  <div class="hero-content">
    <div class="hero-title-wrap" aria-label="Seria's Projects">
      <svg
        class="title-svg"
        viewBox="0 0 600 340"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <text
          class="title-svg-text title-seria"
          x="300"
          y="155"
          text-anchor="middle">Seria's</text
        >
        <text
          class="title-svg-text title-projects"
          x="300"
          y="320"
          text-anchor="middle">Projects</text
        >
      </svg>
    </div>
  </div>

  <button
    class="scroll-hint"
    aria-label="Scroll to next section"
    id="scroll-hint-btn"
  >
    <svg
      class="scroll-arrow"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M12 5v14M5 12l7 7 7-7"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <div class="hero-decoration" aria-hidden="true">
    <div class="deco-circle"></div>
    <div class="deco-group deco-group-1">
      <div class="deco-line deco-line-1"></div>
      <div class="deco-dot deco-dot-1"></div>
      <div class="deco-dot deco-dot-2"></div>
    </div>
    <div class="deco-group deco-group-2">
      <div class="deco-line deco-line-2"></div>
      <div class="deco-dot deco-dot-3"></div>
    </div>
  </div>
</section>

<script>
  function measureAndAnimate() {
    const svg = document.querySelector<SVGSVGElement>(".title-svg");
    const seria = document.querySelector<SVGTextElement>(".title-seria");
    const projects = document.querySelector<SVGTextElement>(".title-projects");
    if (!svg || !seria || !projects) return;

    const seriaBox = seria.getBBox();
    const projectsBox = projects.getBBox();
    const padding = 20;
    const totalWidth =
      Math.max(seriaBox.width, projectsBox.width) + padding * 2;
    const totalHeight = projectsBox.y + projectsBox.height + padding;

    const cx = totalWidth / 2;
    seria.setAttribute("x", String(cx));
    projects.setAttribute("x", String(cx));

    svg.setAttribute("viewBox", `0 0 ${totalWidth} ${totalHeight}`);

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    [seria, projects].forEach((el) => {
      if (reducedMotion) {
        el.style.opacity = "1";
        el.style.strokeDasharray = "";
        el.style.strokeDashoffset = "";
      } else {
        const len = el.getComputedTextLength();
        el.style.strokeDasharray = String(len);
        el.style.strokeDashoffset = String(len);
        el.style.opacity = "1";
      }
    });

    if (!reducedMotion) {
      seria.classList.add("animate-seria");
      projects.classList.add("animate-projects");
    } else {
      seria.style.fillOpacity = "1";
      projects.style.fillOpacity = "1";
    }
  }

  // Wait only for the title's script font, not every font on the page
  const titleText = document.querySelector(".title-svg-text");
  if (document.fonts && titleText) {
    document.fonts
      .load(`160px ${getComputedStyle(titleText).fontFamily}`)
      .then(measureAndAnimate, measureAndAnimate);
  } else {
    window.addEventListener("load", measureAndAnimate);
  }

  document.getElementById("scroll-hint-btn")?.addEventListener("click", () => {
    document.getElementById("featured")?.scrollIntoView({ behavior: "smooth" });
  });

</script>

<style>
  .hero {
    height: 100svh;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    justify-items: center;
    padding: 0 clamp(1rem, 4vw, 3rem);
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    width: 100%;
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero-title-wrap {
    width: 100%;
  }

  .title-svg {
    width: 100%;
    max-width: 600px;
    height: auto;
    overflow: visible;
    display: block;
    margin: 0 auto;
  }

  .title-svg-text {
    font-family: var(--script);
    font-size: 160px;
    fill-opacity: 0;
    stroke-width: 2px;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
  }

  .title-seria {
    fill: var(--ink);
    stroke: var(--ink);
  }

  .title-projects {
    fill: var(--accent);
    stroke: var(--accent);
  }

  /* After stroke draws, fill fades in */
  .title-seria.animate-seria {
    animation:
      stroke-draw 1s cubic-bezier(0.4, 0, 0.2, 1) 0.2s forwards,
      fill-in 0.4s ease 1.1s forwards;
  }

  .title-projects.animate-projects {
    animation:
      stroke-draw 1.1s cubic-bezier(0.4, 0, 0.2, 1) 0.6s forwards,
      fill-in 0.4s ease 1.6s forwards;
  }

  @keyframes stroke-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Animate opacity, not the fill color: Chrome resolves var() in
     fill keyframes to black. */
  @keyframes fill-in {
    to {
      fill-opacity: 1;
    }
  }

  /* Decorative: the circle and two small constellations drift on their own.
     Keyframes use literal values (no var()) so Firefox can run them on the
     compositor; with var() it falls back to the main thread and stutters. */
  @keyframes drift-circle {
    0%,
    100% {
      translate: 0 0;
    }
    25% {
      translate: 14px -10px;
    }
    50% {
      translate: -6px -18px;
    }
    75% {
      translate: -14px 6px;
    }
  }

  @keyframes drift-const-1 {
    0%,
    100% {
      translate: 0 0;
      rotate: 0deg;
    }
    25% {
      translate: -6px 8px;
      rotate: 1.5deg;
    }
    50% {
      translate: 5px 14px;
      rotate: -1deg;
    }
    75% {
      translate: 8px 3px;
      rotate: 1deg;
    }
  }

  @keyframes drift-const-2 {
    0%,
    100% {
      translate: 0 0;
      rotate: 0deg;
    }
    25% {
      translate: 8px -6px;
      rotate: -1deg;
    }
    50% {
      translate: -4px -12px;
      rotate: 1.5deg;
    }
    75% {
      translate: -10px -2px;
      rotate: -0.5deg;
    }
  }

  .hero-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .deco-circle {
    position: absolute;
    right: -8rem;
    top: 50%;
    margin-top: calc(clamp(20rem, 35vw, 42rem) / -2);
    width: clamp(20rem, 35vw, 42rem);
    height: clamp(20rem, 35vw, 42rem);
    border-radius: 50%;
    border: 1px solid color-mix(in oklch, var(--ink) 6%, transparent);
    opacity: 0;
    will-change: transform;
    animation:
      fade-in 1.5s ease 0.3s forwards,
      drift-circle 46s ease-in-out infinite;
  }

  /* Each group spans the hero and turns about its line's anchored end */
  .deco-group {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .deco-group-1 {
    transform-origin: calc(100% - clamp(8rem, 20vw, 22rem)) 0;
    animation: drift-const-1 26s ease-in-out infinite;
  }

  .deco-group-2 {
    transform-origin: 100% 75%;
    animation: drift-const-2 32s ease-in-out -9s infinite;
  }

  .deco-line {
    position: absolute;
    background: color-mix(in oklch, var(--accent) 15%, transparent);
    opacity: 0;
    animation: fade-in 1s ease 1s forwards;
  }

  .deco-line-1 {
    width: 1px;
    height: 30vh;
    right: clamp(8rem, 20vw, 22rem);
    top: 0;
  }

  .deco-line-2 {
    width: 20vw;
    height: 1px;
    right: 0;
    bottom: 25%;
  }

  .deco-dot {
    position: absolute;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
    animation: fade-in 0.5s ease forwards;
  }

  .deco-dot-1 {
    width: 5px;
    height: 5px;
    right: clamp(8rem, 20vw, 22rem);
    top: 30vh;
    animation-delay: 1.2s;
  }

  .deco-dot-2 {
    width: 3px;
    height: 3px;
    right: calc(clamp(8rem, 20vw, 22rem) - 40px);
    top: 30vh;
    animation-delay: 1.4s;
  }

  .deco-dot-3 {
    width: 8px;
    height: 8px;
    right: 20vw;
    bottom: 25%;
    background: color-mix(in oklch, var(--accent) 40%, transparent);
    animation-delay: 1.6s;
  }

  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }

  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    opacity: 0;
    animation: fade-in 0.6s ease 2s forwards;
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
  }

  .scroll-arrow {
    width: 20px;
    height: 20px;
    color: color-mix(in oklch, var(--ink) 35%, transparent);
    animation: scroll-bounce 2s ease-in-out 2.6s infinite;
  }

  @keyframes scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deco-circle,
    .deco-line,
    .deco-dot,
    .scroll-hint {
      animation: none;
      opacity: 1;
    }

    .deco-group {
      animation: none;
    }

    .scroll-arrow {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 0 0.5rem;
    }

    .title-svg {
      max-width: 100%;
    }
  }
</style>
